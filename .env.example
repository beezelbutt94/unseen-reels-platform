# Global environment variables (reference only)
# Copy backend/.env.example and frontend/.env.example to actual .env files

# Node Environment
NODE_ENV=development

# Backend Port
PORT=3001

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Supabase (shared across backend and frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI & Video Production APIs
CLAUDE_API_KEY=sk-ant-...
DID_API_KEY=your-did-api-key
RUNWAY_API_KEY=your-runway-api-key

# Payment Processing
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Cloudinary (Assets & Video Delivery)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Error Tracking
SENTRY_DSN=https://...

# Railway (optional - for local Railway CLI testing)
RAILWAY_TOKEN=your-railway-token
RAILWAY_PROJECT_ID=your-project-id
